{
  "compilerOptions": {
    "target": "ES2022",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@tutwithus/contracts": ["../apps/api/src/contracts/index.ts"],
      "@tutwithus/contracts/admin": ["../apps/api/src/contracts/admin.ts"],
      "@tutwithus/contracts/jobs": ["../apps/api/src/contracts/jobs.ts"]
    }
  },
  "include": ["runner/**/*.ts", "vitest.config.ts"]
}
