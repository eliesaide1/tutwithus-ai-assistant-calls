{
  "name": "@tutwithus/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"node --env-file-if-exists=.env --import tsx\" src/server.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "start:prod": "node --env-file-if-exists=.env dist/server.mjs",
    "build": "node scripts/bundle-node.mjs src/server.ts dist/server.mjs && node scripts/bundle-node.mjs src/whatsapp/whatsapp-agent.ts dist/whatsapp-agent.mjs",
    "job:ping": "node --env-file-if-exists=.env --import tsx scripts/enqueue-ping.ts",
    "admin:create": "node --env-file-if-exists=.env --import tsx scripts/create-admin.ts",
    "admin:migrate-roles": "node --env-file-if-exists=.env --import tsx scripts/migrate-admin-user-roles.ts",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@livekit/agents": "1.9.5",
    "@livekit/agents-plugin-elevenlabs": "1.9.5",
    "@livekit/agents-plugin-openai": "1.9.5",
    "@livekit/rtc-node": "1.2.1",
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "bullmq": "~6.5.3",
    "countries-and-timezones": "3.11.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.15",
    "mammoth": "^1.13.0",
    "mongoose": "^8.19.1",
    "multer": "^2.5.0",
    "openai": "^7.47.0",
    "pdf-parse": "^2.4.5",
    "winston": "^3.19.0",
    "ws": "8.22.1",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.10.0",
    "@types/supertest": "^6.0.3",
    "@types/yauzl": "^3.4.0",
    "esbuild": "^0.28.2",
    "supertest": "^7.1.4",
    "tsx": "^4.23.0",
    "typescript": "~5.9.0",
    "vitest": "^3.2.7"
  }
}
