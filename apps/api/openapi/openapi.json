{
  "openapi": "3.2.0",
  "info": {
    "title": "TutWithUs AI Receptionist API",
    "version": "1.0.0",
    "description": "Shared browser voice REST and server-sent event contracts. Provider realtime event names remain subject to the Sprint 0 technical spike."
  },
  "components": {
    "securitySchemes": {
      "VoiceSessionToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "short-lived session token"
      }
    },
    "schemas": {
      "AccountCheckResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["submitted"]
          },
          "accountStatus": {
            "type": "string",
            "enum": ["verified", "not_registered", "unavailable"]
          }
        },
        "required": ["status", "accountStatus"],
        "additionalProperties": false
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "requestId": {
                "type": "string",
                "minLength": 1
              },
              "details": {
                "type": "object",
                "additionalProperties": {}
              }
            },
            "required": ["code", "message", "requestId"],
            "additionalProperties": false
          }
        },
        "required": ["error"],
        "additionalProperties": false
      },
      "AccountCheckRequest": {
        "type": "object",
        "properties": {
          "memberId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": ["memberId"],
        "additionalProperties": false
      },
      "SubmitBookingRequestResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["submitted"]
          },
          "reference": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["status", "reference"],
        "additionalProperties": false
      },
      "SubmitBookingRequest": {
        "type": "object",
        "properties": {
          "tutorId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "tutorName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "level": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "sessionStart": {
            "type": "string",
            "format": "date-time"
          },
          "sessionEnd": {
            "type": "string",
            "format": "date-time"
          },
          "timezone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "notes": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "tutorId",
          "tutorName",
          "subject",
          "level",
          "sessionStart",
          "sessionEnd",
          "timezone"
        ],
        "additionalProperties": false
      },
      "SaveVoiceTranscriptResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["stored"]
          }
        },
        "required": ["status"],
        "additionalProperties": false
      },
      "SaveVoiceTranscriptRequest": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "speaker": {
            "type": "string",
            "enum": ["user", "assistant"]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": ["eventId", "speaker", "text"],
        "additionalProperties": false
      },
      "PublicConfigResponse": {
        "type": "object",
        "properties": {
          "languages": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["ar-SA", "en", "fr"]
            },
            "minItems": 1
          },
          "consentVersion": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.\\d+$"
          },
          "consentText": {
            "type": "object",
            "properties": {
              "ar-SA": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              },
              "fr": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "maxCallSec": {
            "type": "integer",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "languages",
          "consentVersion",
          "consentText",
          "maxCallSec"
        ],
        "additionalProperties": false
      },
      "CreateVoiceSessionResponse": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "minLength": 1
          },
          "sessionToken": {
            "type": "string",
            "minLength": 1
          },
          "maxDurationSec": {
            "type": "integer",
            "exclusiveMinimum": 0
          }
        },
        "required": ["sessionId", "sessionToken", "maxDurationSec"],
        "additionalProperties": false
      },
      "CreateVoiceSessionRequest": {
        "type": "object",
        "properties": {
          "locale": {
            "type": "string",
            "enum": ["ar-SA", "en", "fr"]
          },
          "timeZone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "consentVersion": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.\\d+$"
          },
          "consentAccepted": {
            "type": "boolean",
            "enum": [true]
          },
          "phone": {
            "type": "string",
            "minLength": 8,
            "maxLength": 24
          },
          "captchaToken": {
            "type": "string",
            "maxLength": 2048
          },
          "identityProof": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "required": ["locale", "consentVersion", "consentAccepted"],
        "additionalProperties": false
      },
      "RealtimeConnectionResponse": {
        "type": "object",
        "properties": {
          "sdp": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          },
          "greeting": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": ["sdp", "greeting"],
        "additionalProperties": false
      },
      "RealtimeConnectionRequest": {
        "type": "object",
        "properties": {
          "sdp": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          }
        },
        "required": ["sdp"],
        "additionalProperties": false
      },
      "VoiceSessionEvent": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["session.live"]
              },
              "sessionId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["type", "sessionId"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["session.ended"]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["type", "reason"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["ui.citations"]
              },
              "citations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "sourceId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["sourceId", "title"],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": ["type", "citations"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["ui.booking.confirm"]
              },
              "draftId": {
                "type": "string",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["type", "draftId", "summary"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["ui.booking.submitted"]
              },
              "draftId": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": ["submitted"]
              },
              "reference": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["type", "draftId", "status", "reference"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["ui.escalation.created"]
              },
              "ticketRef": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["type", "ticketRef"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["ui.error"]
              },
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["type", "code", "message"],
            "additionalProperties": false
          }
        ]
      },
      "EndVoiceSessionResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ended"]
          }
        },
        "required": ["status"],
        "additionalProperties": false
      },
      "EndVoiceSessionRequest": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "additionalProperties": false
      },
      "ConfirmBookingResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["submitted"]
          },
          "reference": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["status", "reference"],
        "additionalProperties": false
      },
      "ConfirmBookingRequest": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "CancelBookingResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["cancelled"]
          }
        },
        "required": ["status"],
        "additionalProperties": false
      },
      "CancelBookingRequest": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/v1/voice/sessions/{sessionId}/account-check": {
      "post": {
        "summary": "Check a browser caller account ID for the active voice session",
        "description": "Returns a coarse match result for the testing website. Does not expose customer identifiers or account details.",
        "security": [
          {
            "VoiceSessionToken": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "sessionId",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountCheckRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Account check completed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountCheckResponse"
                }
              }
            }
          },
          "400": {
            "description": "A request error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "A request error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "A request error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "A request error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/voice/sessions/{sessionId}/booking-requests": {
      "post": {
        "summary": "Submit a verified customer booking request for staff review",
        "security": [
          {
            "VoiceSessionToken": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "sessionId",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitBookingRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Booking request submitted to the admin dashboard.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitBookingRequestResponse"
                }
              }
            }
          },
          "400": {
            "description": "A request error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "A request error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "A request error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "A request error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "A request error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "A request error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/voice/sessions/{sessionId}/transcript": {
      "post": {
        "summary": "Save a completed voice transcript entry",
        "security": [
          {
            "VoiceSessionToken": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "sessionId",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveVoiceTranscriptRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Transcript entry was stored on the active voice session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SaveVoiceTranscriptResponse"
                }
              }
            }
          },
          "400": {
            "description": "A request error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "A request error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "A request error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "A request error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "A request error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/public/config": {
      "get": {
        "summary": "Get public voice configuration",
        "responses": {
          "200": {
            "description": "Supported locales, consent text/version, and call limit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicConfigResponse"
                }
              }
            }
          },
          "500": {
            "description": "A request error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/voice/sessions": {
      "post": {
        "summary": "Create a consented voice session",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateVoiceSessionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session created with a short-lived session token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateVoiceSessionResponse"
                }
              }
            }
          },
          "400": {
            "description": "A request error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "A request error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "A request error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "A request error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/voice/sessions/{sessionId}/connect": {
      "post": {
        "summary": "Exchange an SDP offer for an answer",
        "security": [
          {
            "VoiceSessionToken": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "sessionId",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RealtimeConnectionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "OpenAI Live SDP answer.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RealtimeConnectionResponse"
                }
              }
            }
          },
          "401": {
            "description": "A request error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "A request error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "A request error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "A request error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "A request error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/voice/sessions/{id}/events": {
      "get": {
        "summary": "Stream voice session UI events",
        "security": [
          {
            "VoiceSessionToken": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Server-sent events for the voice session.",
            "content": {
              "text/event-stream": {
                "itemSchema": {
                  "$ref": "#/components/schemas/VoiceSessionEvent"
                }
              }
            }
          },
          "401": {
            "description": "A request error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "A request error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/voice/sessions/{sessionId}/end": {
      "post": {
        "summary": "End a voice session",
        "security": [
          {
            "VoiceSessionToken": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "sessionId",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EndVoiceSessionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session ended.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EndVoiceSessionResponse"
                }
              }
            }
          },
          "401": {
            "description": "A request error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "A request error.",
