# Local development only. Copy to .env; never commit .env or real credentials.
NODE_ENV=development
LOG_LEVEL=info

# API
API_PORT=3000
API_TRUST_PROXY_HOPS=0
# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Admin JWT lifetime in days (1-365). Default: 1 day.
ADMIN_JWT_TTL_DAYS=1
# Optional in development: a random per-process key is used when unset.
# Set a stable random value (at least 32 characters) to preserve admin sessions across restarts.
# Required in production.
# ADMIN_JWT_SECRET=

# MongoDB is required for API persistence. Redis is optional; when unset or
# unavailable, the API keeps call limits in-process and handles maintenance
# requests inline over HTTP instead of using a BullMQ queue.
MONGODB_URI=mongodb://127.0.0.1:27017/tutwithus_dev
REDIS_URL=

# OpenAI Realtime API (server-side only; never expose to the browser).
# Optional for development API startup; required when NODE_ENV=production.
# OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ElevenLabs Saudi Arabic voice synthesis. Choose a voice that is licensed for
# your use case and has a Saudi Arabic accent; the voice ID is in its settings.
ELEVENLABS_API_KEY=replace-with-elevenlabs-api-key
ELEVENLABS_SAUDI_ARABIC_VOICE_ID=replace-with-elevenlabs-saudi-arabic-voice-id
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# WhatsApp Business Calling API over SIP into LiveKit.
# Keep calling disabled until Meta SIP settings and LiveKit dispatch are configured.
WHATSAPP_CALLING_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=replace-with-meta-business-phone-number-id
# For Meta Graph API management only; SIP audio does not use this token.
WHATSAPP_ACCESS_TOKEN=replace-with-meta-cloud-api-access-token
# Required to receive Meta webhook verification and validate webhook signatures.
# Use the Meta app secret and a separate random verify token; never use the access token here.
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_LIVEKIT_SIP_TRUNK_ID=replace-with-livekit-inbound-sip-trunk-id
WHATSAPP_DEFAULT_LOCALE=ar-SA
# Keys the hash of WhatsApp caller numbers stored on session records (the number
# itself is never stored). Required when calling is enabled. Generate a random
# value of at least 16 characters and keep it stable, or repeat callers will
# stop matching. MAX_CALL_SEC, IDLE_TIMEOUT_SEC and RETENTION_DAYS below apply to
# WhatsApp calls too.
CALLER_HASH_SECRET=replace-with-a-random-secret-of-at-least-16-characters
LIVEKIT_URL=wss://replace-with-your-project.livekit.cloud
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret
LIVEKIT_WHATSAPP_AGENT_NAME=tutwithus-whatsapp-agent

# External TutWithUs API. The API and WhatsApp worker call it directly.
TUTWITHUS_API_URL=https://api.tutwithus.com
TUTWITHUS_TIMEOUT_MS=5000
TUTWITHUS_AUTH_LOGIN_PATH=/auth/login
# TUTWITHUS_LOOKUP_PATH=

# API-managed BullMQ worker concurrency when REDIS_URL is configured.
WORKER_CONCURRENCY=5
# Optional credentials for the authenticated job:ping diagnostic command.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# API_BASE_URL=http://127.0.0.1:3000

# Consent and limits
CONSENT_VERSION=2026-11-04.1
MAX_CALL_SEC=300
# Calls allowed at once, and seconds of silence before a call is ended politely.
MAX_CONCURRENT_CALLS=20
IDLE_TIMEOUT_SEC=90
RETENTION_DAYS=30

# These are temporary development notices, not approved production consent text.
CONSENT_TEXT_EN=Your conversation is transcribed and stored in our database for up to {retentionDays} days. Audio recordings are not stored.
CONSENT_TEXT_FR=Votre conversation est transcrite et enregistrée dans notre base de données pendant {retentionDays} jours maximum. Les enregistrements audio ne sont pas conservés.
CONSENT_TEXT_AR=يتم تحويل محادثتك إلى نص وحفظها في قاعدة بياناتنا لمدة تصل إلى {retentionDays} يومًا. لا نحتفظ بالتسجيلات الصوتية.
## Browser turn-taking. Keep these examples aligned with DEFAULT_SERVER_VAD.
# Compare semantic_vad with server_vad during real multilingual call testing.
VOICE_TURN_DETECTION=server_vad
VOICE_VAD_THRESHOLD=0.8
VOICE_SILENCE_MS=500
VOICE_VAD_EAGERNESS=auto



# Secret used to key member-verification rate-limit hashes.
MEMBER_VERIFICATION_SECRET=
# Optional secret shared only with the trusted TutWithUs sign-in backend.
# Enables signed portal phone handoffs; typed-phone/member-ID verification works without it.
BROWSER_IDENTITY_SECRET=
